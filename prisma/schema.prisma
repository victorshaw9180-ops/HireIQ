generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String      @id @default(cuid())
  name                 String
  plan                 String      @default("free")
  
  aiCredits            Int         @default(20)
  paymentProvider      String?

//stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?

// Razorpay
  razorpayCustomerId   String?
  razorpaySubscriptionId String?
  razorpayOrderId      String?

  subscriptionStatus   String?
  
  trialEndsAt          DateTime?
  isTrialExpired       Boolean     @default(false)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  candidates           Candidate[]
  jobs                 Job[]
  members              OrgMember[]
}

model OrgMember {
  id     String       @id @default(cuid())
  orgId  String
  userId String
  role   UserRole     @default(RECRUITER)
  org    Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, userId])
}

model Job {
  id           String        @id @default(cuid())
  orgId        String
  title        String
  department   String?
  location     String?
  salary       String?
  description  String?
  skills       Json?
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  org          Organization  @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Recruiter {
  id        String   @id @default(cuid())
  orgId     String
  clerkId   String   @unique
  name      String
  email     String
  role      UserRole @default(RECRUITER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([orgId])
}

model Candidate {
  id           String        @id @default(cuid())
  orgId        String
  name         String
  email        String        @unique
  phone        String?
  source       String?
  parsedData   Json?
  createdAt    DateTime      @default(now())
  applications Application[]
  org          Organization  @relation(fields: [orgId], references: [id])
  rankingScore Int           @default(0)
  @@index([orgId])
}

model Resume {
  id        String   @id @default(cuid())
  orgId     String
  fileName  String
  fileSize  Int
  fileUrl   String?
  fileType  String?
  aiScore   Float?
  summary   String?
  createdAt DateTime @default(now())

  @@index([orgId])
}

model Application {
  id                  String     @id @default(cuid())
  candidateId         String
  jobId               String
  orgId               String
  stage               Stage      @default(NEW)
  
  decision     CandidateDecision @default(PENDING)
  recruiterName       String?
  
  assignedRecruiterId String?
  assignedRecruiter   Recruiter? @relation(fields: [assignedRecruiterId], references: [id])
  
  submittedAt         DateTime?
  
  aiScore             Float?
  matchScore          Float?
  resumeScore         Float?
  skillsScore         Float?
  experienceScore     Float?
  scoreReason         String?
  notes               Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  activities          Activity[]
  notesFeed           CandidateNote[]
  interviews          Interview[]
  candidate           Candidate  @relation(fields: [candidateId], references: [id])
  job                 Job        @relation(fields: [jobId], references: [id])
  
  @@index([jobId])
  @@index([candidateId])
  @@index([orgId])
}

model Activity {
  id            String      @id @default(cuid())
  applicationId String
  type          String
  content       String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model CandidateNote {
  id            String      @id @default(cuid())
  applicationId String
  recruiterName String
  content       String
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model Interview {
  id              String            @id @default(cuid())
  applicationId   String
  title           String
  interviewerName String
  scheduledAt     DateTime
  status          InterviewStatus   @default(SCHEDULED)
  feedback        String?
  createdAt       DateTime          @default(now())

  application     Application       @relation(fields: [applicationId], references: [id])
  feedbacks InterviewFeedback[]
  @@index([applicationId])
}

model InterviewFeedback {
  id            String    @id @default(cuid())
  interviewId   String
  rating        Int
  feedback      String
  recommendation String
  createdAt     DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id])

  @@index([interviewId])
}

model Subscription {
  id                String   @id @default(cuid())
  clerkUserId       String
  plan              String
  status            String
  aiCredits         Int      @default(20)
  
  // Trial
  trialEndsAt       DateTime?
  isTrialExpired    Boolean  @default(false)  
  
  // Stripe
  stripeCustomerId  String?
  stripeSubId       String?

  // Razorpay
  razorpayCustomerId String?
  razorpaySubId      String?
  razorpayOrderId    String?

  currentPeriodEnd  DateTime?
 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([clerkUserId])
}

enum Stage {
  NEW
  SCREENING
  INREVIEW
  SUBMITTED
  SHORTLISTED
  INTERVIEW
  INTERVIEW1
  INTERVIEW2
  REJECTED
  OFFER
  HIRED
  TERMINATED 
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum CandidateDecision {
  PENDING
  SELECTED
  REJECTED
  ON_HOLD
  NEXT_ROUND
}

enum UserRole {
  OWNER
  ADMIN
  RECRUITER
  MANAGER  
}